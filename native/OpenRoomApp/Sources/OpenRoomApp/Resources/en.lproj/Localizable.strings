/* Development language. Keys are the English source text, so a missing entry in
   another locale falls back to correct English rather than to a raw key. */

/* Scenario */
"Discussion" = "Discussion";
"Fills in background on the tools, terms and numbers people mention, and flags claims worth checking." = "Fills in background on the tools, terms and numbers people mention, and flags claims worth checking.";
"Interview" = "Interview";
"Judges whether the candidate's answers are correct or vague, and suggests what to press on next." = "Judges whether the candidate's answers are correct or vague, and suggests what to press on next.";

/* Speakers. %lld is the 1-based order of first appearance; SPEAKER_00 means nothing to a human. */
"Speaker %lld" = "Speaker %lld";

/* Markdown export. %1$@ timestamp, %2$@ speaker name, %3$@ text. */
"# Meeting Transcript" = "# Meeting Transcript";
"[%1$@] %2$@: %3$@" = "[%1$@] %2$@: %3$@";
"[%1$@] %2$@" = "[%1$@] %2$@";

/* Backend (sidecar python process) */
"%@ not found — run `uv venv --python 3.11` in the repo first" = "%@ not found — run `uv venv --python 3.11` in the repo first";
"Backend process exited unexpectedly (exit %lld)" = "Backend process exited unexpectedly (exit %lld)";
"Could not launch python -m openroom.server: %@" = "Could not launch python -m openroom.server: %@";
"Backend never opened port 8000 in 90 seconds" = "Backend never opened port 8000 in 90 seconds";

/* Audio capture failures — stay specific, these are the only clue the user gets. */
"No display found. ScreenCaptureKit audio capture has to be bound to a display or window." = "No display found. ScreenCaptureKit audio capture has to be bound to a display or window.";
"System audio capture failed: %@. On first run you have to grant access in System Settings > Privacy & Security > Screen & System Audio Recording." = "System audio capture failed: %@. On first run you have to grant access in System Settings > Privacy & Security > Screen & System Audio Recording.";
"System audio capture stopped: %@" = "System audio capture stopped: %@";
"Could not build a %lld Hz mono audio converter" = "Could not build a %lld Hz mono audio converter";
"Microphone failed to start: %@" = "Microphone failed to start: %@";

/* WebSocket */
"Connection closed: %@. Is the backend running?" = "Connection closed: %@. Is the backend running?";

